# ===================================================================
# CONFIGURACIÓN DEL SISTEMA UCO ANALYTICS
# ===================================================================

# -------------------------------------------------------------------
# MOTOR DE BASE DE DATOS
# Opciones: 'sqlite' (Instalación Local / Offline) o 'sqlserver' (Servidor en Línea)
# -------------------------------------------------------------------
DB_ENGINE=sqlite

# Para usar Microsoft SQL Server, configure DB_ENGINE=sqlserver y complete estos datos:
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=UCO_Analytics
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=TuPasswordSeguro123*
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# O alternativamente, URL completa de conexión a SQL Server:
# DATABASE_URL=mssql+pyodbc://sa:TuPassword@localhost:1433/UCO_Analytics?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# -------------------------------------------------------------------
# SEGURIDAD Y JWT
# -------------------------------------------------------------------
SECRET_KEY=clave_secreta_super_segura_debe_cambiarse_en_produccion_2026
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Modo de Autenticación: 'LOCAL' (JWT nativo con Bcrypt) o 'KEYCLOAK' (SSO UCO)
AUTH_MODE=LOCAL

# -------------------------------------------------------------------
# INTEGRACIÓN KEYCLOAK (Opcional - Sólo si AUTH_MODE=KEYCLOAK)
# -------------------------------------------------------------------
KEYCLOAK_SERVER_URL=https://sso.uco.edu.co/auth
KEYCLOAK_REALM=uco-institucional
KEYCLOAK_CLIENT_ID=uco-analytics-client
KEYCLOAK_CLIENT_SECRET=
