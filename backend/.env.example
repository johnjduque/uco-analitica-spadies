# ===================================================================
# CONFIGURACIÓN DE UCO ANALYTICS  (copie este archivo como .env)
# Nunca suba el archivo .env al repositorio.
# ===================================================================

# Entorno: desarrollo (equipo local) | produccion (servidor)
APP_ENV=desarrollo

# -------------------------------------------------------------------
# BASE DE DATOS
#   sqlite    -> instalación local (archivo datos_uco.db)
#   sqlserver -> servidor institucional
# -------------------------------------------------------------------
DB_ENGINE=sqlite
SQLITE_DB_NAME=datos_uco.db

SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=UCO_Analytics
# Use un usuario dedicado con permisos solo sobre esta base (no 'sa')
SQLSERVER_USER=uco_analytics_app
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# 'yes' solo si el servidor usa un certificado autofirmado
SQLSERVER_TRUST_CERT=no

# -------------------------------------------------------------------
# SEGURIDAD
# -------------------------------------------------------------------
# Obligatoria en producción (mínimo 32 caracteres aleatorios). Genérela con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# En instalación local puede dejarse vacía: se genera una automáticamente.
SECRET_KEY=

# Administrador inicial (solo se crea si la base no tiene usuarios).
# Si no define la contraseña, se genera una temporal y se muestra una vez en la consola.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Orígenes adicionales permitidos (CORS), separados por coma. Normalmente vacío.
CORS_ORIGINS=

# Documentación interactiva /docs (por defecto activa solo en desarrollo)
ENABLE_DOCS=

# -------------------------------------------------------------------
# SERVIDOR DE ESCRITORIO (ejecutable Windows)
# -------------------------------------------------------------------
# 127.0.0.1 = solo este equipo. 0.0.0.0 = accesible desde la red local (no recomendado sin HTTPS).
APP_HOST=127.0.0.1
APP_PORT=8000
