# Proxy inverso con HTTPS automático (Let's Encrypt si DOMAIN es un dominio público;
# certificado interno si DOMAIN=localhost o una IP).
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 210MB
	}
	reverse_proxy app:8000
}
