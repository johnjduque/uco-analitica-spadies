# ===================================================================
# Variables para docker compose (copie como .env en la raíz del proyecto)
# ===================================================================
# Dominio público del sistema (ej. analitica.uco.edu.co). Use localhost para pruebas.
DOMAIN=localhost

# Contraseña del administrador de SQL Server (mín. 8, mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD=

# Usuario de la aplicación en SQL Server. Para un primer despliegue puede usar 'sa' con la
# contraseña anterior; se recomienda crear luego un usuario dedicado (ver README).
SQLSERVER_DATABASE=UCO_Analytics
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# Llave de firma de sesiones (obligatoria). Genérela con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Administrador inicial (se crea solo si la base está vacía; debe cambiar la clave al ingresar)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
